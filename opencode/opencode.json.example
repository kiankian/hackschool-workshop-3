{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--isolated"
        ],
        "disabled": false
      }
    }
  },
  "plugins": [
    "@dietrichgebert/ponytail"
  ]
}
